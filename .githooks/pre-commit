#!/bin/sh
# Repository pre-commit hook.
#
# This file is tracked, and is reached through the global hooks directory
# (git config --global core.hooksPath), which dispatches to it. That
# indirection matters: when core.hooksPath is set, git ignores .git/hooks
# entirely, so anything installed there -- by simple-git-hooks or by hand --
# never runs. `git rev-parse --git-path hooks` shows which directory git
# actually reads.
#
# Bypass (rare, intentional): git commit --no-verify

set -e

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Format and lint only what is staged. Everything here is deliberately
# sub-second, and everything below is scoped to what was staged for the
# same reason: a hook that makes you wait on work you did not touch is a
# hook people learn to route around, and then it protects nothing.
if ! (cd "$toplevel" && bunx --bun lint-staged); then
  echo "" >&2
  echo "✖ pre-commit hook: staged files failed lint or formatting (see above)." >&2
  echo "  Bypass only when you know why: git commit --no-verify" >&2
  exit 1
fi

# --staged makes the checker return immediately when nothing it cares about
# is staged. Which paths those are is the checker's business, not the hook's,
# so the decision lives in one place; paying for a generator run on every
# commit would make this hook something people route around.
if ! bash "$toplevel/scripts/check-codegen-drift.sh" --staged; then
  echo "" >&2
  echo "✖ pre-commit hook: the schema and its generated code disagree (see above)." >&2
  echo "  A schema change and the code generated from it belong in the same commit." >&2
  echo "  Bypass only when you know why: git commit --no-verify" >&2
  exit 1
fi

# An override selector that matches nothing produces exactly the output no
# override would, so the comparison above has no diff to find: a renamed
# column or a typo turns the rule off in silence. It reads the same inputs
# the drift check does and costs a fraction of a second, so it is gated on
# the same paths rather than on its own.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^sql/'; then
  if ! (cd "$toplevel" && go -C scripts run check-sqlc-overrides.go); then
    echo "" >&2
    echo "✖ pre-commit hook: a sqlc override selector names nothing in the schema (see above)." >&2
    echo "  The JSON tag or Go type that override exists to enforce is not being applied." >&2
    echo "  Fix the selector in sql/sqlc.yaml, or drop it if the column is gone." >&2
    exit 1
  fi
fi

# The error catalog is generated from errors/*.yaml the way the data layer
# is generated from the schema, and it drifted the same way: a YAML edit
# without a regeneration left the Go constants, the TS catalog and the docs
# describing something their source no longer said. The check rebuilds every
# output in memory and compares it against what is committed, so it writes
# nothing; comparing the files rather than a hash of the sources also catches
# a change in the generator and a hand-edit of its output. Gated on either
# the catalog or the generator being staged -- a change to either can make
# the committed output wrong.
if git diff --cached --name-only --diff-filter=ACMR |
  grep -qE '^(errors/.*\.yaml|scripts/gen-errors\.go)$'; then
  if ! (cd "$toplevel" && go -C scripts run gen-errors.go --check); then
    echo "" >&2
    echo "✖ pre-commit hook: errors/*.yaml changed without regenerating (see above)." >&2
    echo "  Run 'make gen-errors' and stage the result." >&2
    echo "  Bypass only when you know why: git commit --no-verify" >&2
    exit 1
  fi
fi

# A design-token reference that carries a stray closing paren is invalid
# CSS, so the browser drops the whole declaration without saying anything:
# no error, no fallback, just a style that is absent. It is also the kind of
# typo that gets copied — one occurrence became many before anything caught
# it. The scan is a paren-balance test over the styles and costs about as
# much as reading them, so it is gated on styling files being staged rather
# than on nothing at all.
if git diff --cached --name-only --diff-filter=ACMR |
  grep -qE '\.(css|tsx?)$'; then
  if ! bash "$toplevel/scripts/check-css-var-parens.sh"; then
    echo "" >&2
    echo "✖ pre-commit hook: a var(--nf-...) reference has a stray closing paren (see above)." >&2
    echo "  The declaration around it is dropped by the browser." >&2
    echo "  Bypass only when you know why: git commit --no-verify" >&2
    exit 1
  fi
fi

# The signal-kind registry generates the same three kinds of artefact, plus
# the flow-web locale bundles. It is checked by comparing the files rather
# than a hash of the sources, because its failure mode was the generator
# itself: it wrote the English copy into every locale, which a source hash
# calls fresh. Gated on either the registry or the generator being staged —
# a change to either can make the committed output wrong.
if git diff --cached --name-only --diff-filter=ACMR |
  grep -qE '^(signal_kinds/.*\.yaml|scripts/gen-signal-kinds\.go)$'; then
  if ! (cd "$toplevel" && go -C scripts run gen-signal-kinds.go --check); then
    echo "" >&2
    echo "✖ pre-commit hook: the signal-kind registry and its generated files disagree (see above)." >&2
    echo "  Run 'make gen-signal-kinds' and stage the result." >&2
    echo "  Bypass only when you know why: git commit --no-verify" >&2
    exit 1
  fi
fi

# The last generator behind `make verify-codegen`. The api cannot call the
# TypeScript holiday provider, so the dates it needs are projected into an
# embedded dataset; a provider change that never reached the projection
# leaves the server and the browser disagreeing about which days are
# working days, and nothing else compares them. It is the slowest of these
# checks by an order of magnitude and its inputs change a few times a year,
# which is exactly the shape a path gate is for.
if git diff --cached --name-only --diff-filter=ACMR |
  grep -qE '^(packages/holidays/|packages/go-shared/holidays/data\.json$|scripts/gen-holidays\.ts$)'; then
  if ! (cd "$toplevel" && bun run scripts/gen-holidays.ts --check); then
    echo "" >&2
    echo "✖ pre-commit hook: the embedded holiday dataset no longer matches the provider (see above)." >&2
    echo "  Run 'make gen-holidays' and stage the result." >&2
    exit 1
  fi
fi

# The suites for what is being committed. Everything above reads the
# sources; nothing above runs the code, which is how a commit whose unit
# tests fail reaches the branch with every local gate reporting green.
# Work here lands straight on the working branch, so a failure CI finds is
# a failure already in the history.
#
# --staged keeps the cost proportional: only the modules and workspaces a
# staged file can break, and the Go test cache means a package a change did
# not reach is not re-run. Container-backed suites and the whole-module
# source scanners stay out; those are minutes, and CI runs them.
#
# One limitation, stated because it cannot be fixed here: this exercises
# the working tree, not the staged content. A partially staged file is
# tested as it sits on disk. Hiding the unstaged half would mean stashing,
# which can discard work outright, and that is a worse failure than a test
# run that saw one file too many.
if ! node "$toplevel/scripts/run-unit-tests.mjs" --staged; then
  echo "" >&2
  echo "✖ pre-commit hook: a test suite covering the staged changes failed (see above)." >&2
  echo "  Run 'make test-unit' to see the whole picture without the staging filter." >&2
  echo "  A failing test is the one thing here that is never a false alarm." >&2
  exit 1
fi
