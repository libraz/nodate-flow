{
  "uid": "nf-ai-cost",
  "title": "AI Cost & Usage",
  "tags": ["nodate-flow", "ai", "cost"],
  "timezone": "browser",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "AI Invocations (req/s)",
      "description": "Rate of AI provider calls, in total and split by provider. nf_ai_invocations_total is a counter with labels: provider, model, outcome.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_ai_invocations_total[5m]))",
          "legendFormat": "total"
        },
        {
          "expr": "sum by (provider) (rate(nf_ai_invocations_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "AI Request Duration p50 / p95 / p99",
      "description": "Latency of AI provider calls, aggregated across every provider and model. nf_ai_request_duration_seconds is a histogram with labels: provider, model. Its buckets run to two minutes rather than stopping at the Prometheus default of ten seconds, because an LLM completion routinely runs longer than that.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(nf_ai_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(nf_ai_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(nf_ai_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Token Usage (tokens/s)",
      "description": "Token consumption rate split by direction. nf_ai_tokens_total is a counter with labels: type (prompt, completion), model.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (type) (rate(nf_ai_tokens_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Estimated Cost (USD/h)",
      "description": "Estimated hourly AI cost across every provider and model. nf_ai_cost_dollars_total is a counter with labels: provider, model.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_ai_cost_dollars_total[1h])) * 3600",
          "legendFormat": "all providers and models $/h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Requests by Model",
      "description": "Distribution of AI calls across models.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (model) (increase(nf_ai_invocations_total[24h]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "AI Error Rate",
      "description": "Rate of failed AI provider calls. Uses nf_ai_invocations_total{outcome=\"error\"}, broken down by the provider label.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_ai_invocations_total{outcome=\"error\"}[5m]))",
          "legendFormat": "total errors"
        },
        {
          "expr": "sum by (provider) (rate(nf_ai_invocations_total{outcome=\"error\"}[5m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "schemaVersion": 39,
  "version": 1
}
