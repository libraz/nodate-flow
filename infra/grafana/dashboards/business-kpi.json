{
  "uid": "nf-business-kpi",
  "title": "Business KPIs",
  "tags": ["nodate-flow", "business", "kpi"],
  "timezone": "browser",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Task Creation Rate",
      "description": "Rate of new tasks being created. Metric nf_tasks_created_total is expected as a counter with labels: workspace_id.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_tasks_created_total[5m]))",
          "legendFormat": "tasks created/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Task Completion Rate",
      "description": "Rate of tasks transitioning to a completed state. Metric nf_tasks_completed_total is expected as a counter.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_tasks_completed_total[5m]))",
          "legendFormat": "tasks completed/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Active Workspaces",
      "description": "Number of workspaces with at least one API request in the last 5 minutes.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "count(sum by (workspace_id) (rate(nf_http_requests_total[5m]) > 0))",
          "legendFormat": "active workspaces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [{ "value": 0, "color": "blue" }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Task State Distribution",
      "description": "Current distribution of tasks across states. Metric nf_tasks_by_state is expected as a gauge with label: state.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (state) (nf_tasks_by_state)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Total Tasks (gauge)",
      "description": "Total number of tasks across all workspaces. Metric nf_tasks_total is expected as a gauge.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(nf_tasks_total)",
          "legendFormat": "total tasks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [{ "value": 0, "color": "blue" }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Task State Transitions (events/s)",
      "description": "Rate of task state change events. Metric nf_task_state_transitions_total is expected as a counter with labels: from_state, to_state.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_task_state_transitions_total[5m]))",
          "legendFormat": "total transitions/s"
        },
        {
          "expr": "sum by (to_state) (rate(nf_task_state_transitions_total[5m]))",
          "legendFormat": "to:{{to_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "User Registrations Rate",
      "description": "Rate of new user sign-ups. Metric nf_users_registered_total is expected as a counter.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(nf_users_registered_total[5m]))",
          "legendFormat": "registrations/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "schemaVersion": 39,
  "version": 1
}
