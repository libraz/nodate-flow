# nodate-flow environment variables (copy to .env and fill in).
# All runtime config uses the NF_* prefix. Never commit .env.

# --- API server ---
NF_PORT=8080
NF_LOG_LEVEL=info
# Optional build/version tag surfaced in logs and /health.
NF_VERSION=dev

# Comma-separated list of origins allowed to call the API with
# credentials. Defaults to the Vite dev server on localhost. Set to
# "*" to allow any origin (credentials will then be disabled per the
# CORS spec). Leave empty to disable CORS entirely.
NF_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# DSN used by the api process to reach MySQL.
# In compose, the mysql service is reachable as host "mysql".
NF_DB_DSN=nodate:nodatepw@tcp(mysql:3306)/nodate_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
# Used only by the mysql container during first boot.
NF_DB_NAME=nodate_flow
NF_DB_USER=nodate
NF_DB_PASSWORD=nodatepw
NF_DB_ROOT_PASSWORD=rootpw
NF_DB_PORT=3306
NF_API_PORT=8080

# --- Secrets / crypto ---
# 32-byte master key for AES-256-GCM column encryption, hex or base64.
# Generate with: openssl rand -hex 32
NF_SECRET_KEY=

# --- Auth (optional at scaffold time) ---
# Ed25519 private key for JWT signing (PEM). Ephemeral if unset.
NF_JWT_PRIVATE_KEY=
NF_OIDC_GOOGLE_CLIENT_ID=
NF_OIDC_GOOGLE_CLIENT_SECRET=
NF_OIDC_GOOGLE_REDIRECT_URL=
# Toggles the Secure flag on the httpOnly refresh cookie (nf_rt).
# - false (default here): http://localhost dev. The cookie is sent as
#   SameSite=Lax so the browser stores it and replays it on the boot
#   POST /auth/refresh call from the Vite dev server.
# - true: any https deployment. The cookie is sent as SameSite=None;
#   Secure so it survives the cross-site fetch from the web origin to
#   the api origin.
# Override this to true in any non-localhost environment.
NF_COOKIE_SECURE=false

# --- URLs ---
# Externally-visible origin of the API, used to build OAuth redirect
# URIs for personal integrations (GitHub, Slack, Google Calendar).
NF_PUBLIC_BASE_URL=http://localhost:8080
# Where the user is redirected after the OAuth callback completes.
NF_WEB_BASE_URL=http://localhost:5173

# --- Integrations: webhooks ---
# Shared HMAC secret for GitHub webhook (X-Hub-Signature-256).
NF_GH_WEBHOOK_SECRET=
# Slack v0 signing secret.
NF_SLACK_SIGNING_SECRET=
# Google Drive push notification channel token.
NF_GOOGLE_CHANNEL_TOKEN=
# Stop-gap: public workspace id (UUID v7) that inbound webhook
# signals are routed to until a per-repo mapping table exists.
NF_DEFAULT_WORKSPACE_ID=

# --- Integrations: OAuth apps (personal integrations) ---
# All optional. When client id/secret is empty the provider reports
# as unavailable and enrollment returns INTEGRATION.PROVIDER.NOT_CONFIGURED.
NF_GITHUB_CLIENT_ID=
NF_GITHUB_CLIENT_SECRET=
NF_SLACK_CLIENT_ID=
NF_SLACK_CLIENT_SECRET=
NF_GOOGLE_CLIENT_ID=
NF_GOOGLE_CLIENT_SECRET=

# --- Realtime (SSE) ---
# Toggle the in-process SSE fan-out (ADR 0005). Default true.
NF_STREAM=true

# --- Outbound rate limiter (4.SEC-2) ---
# Per-provider LLM egress cap in requests per second. 0 = disabled.
# When > 0, applied uniformly to anthropic / openai / google / ollama.
NF_OUTBOUND_LLM_RPS=0
# Burst size. 0 = derived from NF_OUTBOUND_LLM_RPS.
NF_OUTBOUND_LLM_BURST=0

# --- AI / cost guard ---
# Per-workspace daily budget cap in cents. Empty = use built-in default.
NF_AI_DAILY_BUDGET_CENTS=
# Toggle the deterministic in-memory AI provider (fixture-backed).
# true = ignore workspace.ai_providers rows, use testdata/ai/ fixtures.
NF_AI_MOCK=false

# --- Session / Redis ---
# Session store driver: "mysql" (default) or "redis".
NF_SESSION_STORE=mysql
# Redis host:port shared by redis-tagged drivers (session, stream, outbound).
NF_REDIS_ADDR=
NF_REDIS_PORT=6379

# --- Stream / outbound backends ---
# SSE fan-out driver: "memory" (default) or "redis".
NF_STREAM_BACKEND=memory
# Egress rate limiter driver: "memory" (default) or "redis".
NF_OUTBOUND_BACKEND=memory

# --- Agent runtime ---
# Global tick interval for the agent scheduler.
NF_AGENT_TICK_INTERVAL=1m
# Queue backend: "memory" (default, single-process) or "mysql" (multi-replica).
NF_AGENT_QUEUE_BACKEND=memory
# Number of in-process agent workers. 0 disables the worker loop.
NF_AGENT_WORKER_COUNT=1
# Runner implementation: "orchestrator" (default, writes events + LLM calls) or "log" (structured-log only, no events).
NF_AGENT_RUNNER=orchestrator
# How often the purger deletes completed agent_runs rows (mysql queue only).
# 0 disables the purger.
NF_AGENT_RUNS_PURGE_INTERVAL=1h
# Minimum age before a finished agent_runs row is purged.
NF_AGENT_RUNS_RETENTION=168h

# --- S3 / MinIO ---
# S3-compatible object store for file uploads. When NF_S3_ENDPOINT is
# empty, upload endpoints return INTERNAL.NOT_CONFIGURED.
NF_S3_ENDPOINT=minio:9000
NF_S3_ACCESS_KEY=minioadmin
NF_S3_SECRET_KEY=minioadmin
NF_S3_BUCKET=nodate-flow
NF_S3_USE_SSL=false

# --- Registration ---
# Set to false to disable new user sign-up (POST /auth/register → 403).
NF_REGISTRATION_OPEN=true

# --- nodate-time API ---
NT_PORT=8081
NT_DB_DSN=nodate:nodatepw@tcp(mysql:3306)/nodate_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
NT_CORS_ALLOWED_ORIGINS=http://localhost:5174
NT_COOKIE_SECURE=false

# --- Tests ---
# Set to 1 to enable integration tests that require a live MySQL.
NF_TEST_INTEGRATION=
