# nodate-flow environment variables (copy to .env and fill in).
# All runtime config uses the NF_* prefix. Never commit .env.
#
# Per-app sub-prefixes:
#   NF_FLOW_*  — flow-api specific (calendar handlers live here too)
#   NF_AUTH_*  — auth-api specific
# Shared vars have no sub-prefix (NF_DB_DSN, NF_COOKIE_SECURE, etc.).

# --- Runtime environment (shared) ---
# Selects the runtime mode for both APIs. "development" (the default) tolerates
# developer conveniences: an ephemeral JWT signing key when NF_SECRET_KEY is
# unset, and the NF_CORS_DEV_LOCALHOST relaxation. Any other value (e.g.
# "production") is treated as production, where boot hard-fails unless
# NF_SECRET_KEY is set, NF_*_CORS lists explicit (non-"*") origins, and
# NF_CORS_DEV_LOCALHOST is false.
NF_ENV=development

# --- flow-api server ---
NF_FLOW_PORT=8080
# Internal-only Prometheus /metrics port. Separate from NF_FLOW_PORT so
# /metrics is never reachable through the public API port; it is scraped
# over the container network only (infra/prometheus/prometheus.yml).
NF_FLOW_METRICS_PORT=9090
NF_FLOW_LOG_LEVEL=info
# Optional build/version tag surfaced in logs and /health.
NF_VERSION=dev

# Comma-separated list of origins allowed to call the API with
# credentials. Defaults to the Vite dev server on localhost. Set to
# "*" to allow any origin (credentials will then be disabled per the
# CORS spec). Leave empty to disable CORS entirely.
NF_FLOW_CORS=http://localhost:5173,http://127.0.0.1:5173

# Webhook SSRF escape hatch for local development only. When "1" or
# "true", webhook URLs may use http and resolve to loopback / private
# addresses. NEVER enable in production: it disables the guard that
# stops webhook delivery from reaching internal networks and cloud
# metadata endpoints.
NF_WEBHOOK_ALLOW_PRIVATE=

# --- auth-api server ---
NF_AUTH_PORT=8082
# Internal-only Prometheus /metrics port. Separate from NF_AUTH_PORT so
# /metrics is never reachable through the public API port; it is scraped
# over the container network only (infra/prometheus/prometheus.yml).
NF_AUTH_METRICS_PORT=9092
NF_AUTH_LOG_LEVEL=info
NF_AUTH_CORS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175
# Dev-only: when true, both APIs additionally accept any
# http://localhost:<port> or http://127.0.0.1:<port> origin (on top of
# NF_FLOW_CORS / NF_AUTH_CORS). Use this when the Vite dev server lands
# on a non-default port (e.g. 5183 because 5173 is already taken). Leave
# false (the default) in any non-localhost deployment.
NF_CORS_DEV_LOCALHOST=false
# Refresh-token session store driver: "mysql" (default) or "redis".
# "redis" requires NF_REDIS_ADDR; auth-api refuses to start if the
# address is missing or unreachable rather than quietly using MySQL.
NF_AUTH_SESSION_STORE=mysql
NF_AUTH_PUBLIC_URL=http://localhost:8082
NF_AUTH_WEB_URL=http://localhost:5175
NF_AUTH_FLOW_WEB_URL=http://localhost:5173

# --- auth-api integrations (OAuth personal connections) ---
NF_AUTH_GITHUB_CLIENT_ID=
NF_AUTH_GITHUB_CLIENT_SECRET=
NF_AUTH_SLACK_CLIENT_ID=
NF_AUTH_SLACK_CLIENT_SECRET=
NF_AUTH_GOOGLE_INTEGRATION_CLIENT_ID=
NF_AUTH_GOOGLE_INTEGRATION_CLIENT_SECRET=
NF_AUTH_DISCORD_CLIENT_ID=
NF_AUTH_DISCORD_CLIENT_SECRET=
NF_AUTH_DISCORD_REDIRECT_URI=

# --- auth-api SMTP ---
NF_AUTH_SMTP_HOST=mailpit
NF_AUTH_SMTP_PORT=1025
NF_AUTH_SMTP_USERNAME=
NF_AUTH_SMTP_PASSWORD=
NF_AUTH_SMTP_FROM=noreply@nodate-flow.local

# --- Database (shared) ---
# DSN used by all api processes to reach MySQL.
# In compose, the mysql service is reachable as host "mysql".
NF_DB_DSN=nodate:nodatepw@tcp(mysql:3306)/nodate_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
# Used only by the mysql container during first boot.
NF_DB_NAME=nodate_flow
NF_DB_USER=nodate
NF_DB_PASSWORD=nodatepw
NF_DB_ROOT_PASSWORD=rootpw
NF_DB_PORT=3306
NF_API_PORT=8080

# --- Secrets / crypto ---
# 32-byte master key for AES-256-GCM column encryption, hex or base64.
# Generate with: openssl rand -hex 32
NF_SECRET_KEY=

# --- Auth (shared) ---
# Ed25519 private key for JWT signing (PEM). Ephemeral if unset.
NF_JWT_PRIVATE_KEY=
NF_AUTH_GOOGLE_CLIENT_ID=
NF_AUTH_GOOGLE_CLIENT_SECRET=
NF_AUTH_MICROSOFT_OIDC_CLIENT_ID=
NF_AUTH_MICROSOFT_OIDC_CLIENT_SECRET=
# Required when Microsoft OIDC is enabled. Comma-separated Entra tenant
# IDs allowed to sign in; tokens from other tenants are rejected.
NF_AUTH_MICROSOFT_OIDC_ALLOWED_TENANTS=
# Toggles the Secure flag on the httpOnly refresh cookie (nf_rt).
# - false (default here): http://localhost dev. The cookie is sent as
#   SameSite=Lax so the browser stores it and replays it on the boot
#   POST /auth/refresh call from the Vite dev server.
# - true: any https deployment. The cookie is sent as SameSite=None;
#   Secure so it survives the cross-site fetch from the web origin to
#   the api origin.
# Override this to true in any non-localhost environment.
NF_COOKIE_SECURE=false
# Fixed number of trusted reverse-proxy hops in front of the APIs.
# 0 (default) ignores X-Forwarded-For / X-Real-Ip and uses RemoteAddr.
# Set to 1 when every request reaches the APIs through exactly one
# trusted proxy that overwrites/appends forwarding headers.
NF_TRUSTED_PROXY_HOPS=0

# --- URLs (flow-api) ---
# Externally-visible origin of the flow-api, used to build OAuth redirect
# URIs for personal integrations (GitHub, Slack, Google Calendar).
NF_FLOW_PUBLIC_URL=http://localhost:8080
# Origin of the flow-web frontend. Used by flow-api for OAuth callback
# redirects and by the calendar handlers to build /invites/accept
# magic-link URLs embedded in outbound calendar invite emails.
NF_FLOW_WEB_URL=http://localhost:5173

# --- Integrations: webhooks (flow-api) ---
# Shared HMAC secret for GitHub webhook (X-Hub-Signature-256).
NF_FLOW_GH_WEBHOOK_SECRET=
# Slack v0 signing secret.
NF_FLOW_SLACK_SIGNING_SECRET=
# Google Drive push notification channel token.
NF_FLOW_GOOGLE_CHANNEL_TOKEN=
# Single-tenant only: public workspace id (UUID v7) that inbound webhook
# deliveries fall back to when the sending repository / Slack team /
# push channel has no integration source mapping. Ignored once the
# instance hosts more than one workspace, because filing one tenant's
# events under another is worse than refusing the delivery. Multi-tenant
# deployments leave this empty and map each source through
# POST /workspaces/{wsId}/integration-mappings.
NF_FLOW_DEFAULT_WORKSPACE_ID=

# --- Integrations: OAuth apps (personal integrations, flow-api) ---
# All optional. When client id/secret is empty the provider reports
# as unavailable and enrollment returns INTEGRATION.PROVIDER.NOT_CONFIGURED.
NF_FLOW_GITHUB_CLIENT_ID=
NF_FLOW_GITHUB_CLIENT_SECRET=
NF_FLOW_SLACK_CLIENT_ID=
NF_FLOW_SLACK_CLIENT_SECRET=
NF_FLOW_GOOGLE_CLIENT_ID=
NF_FLOW_GOOGLE_CLIENT_SECRET=

# --- flow-api SMTP ---
NF_FLOW_SMTP_HOST=mailpit
NF_FLOW_SMTP_PORT=1025
NF_FLOW_SMTP_USERNAME=
NF_FLOW_SMTP_PASSWORD=
NF_FLOW_SMTP_FROM=noreply@nodate-flow.local

# --- Mailpit (dev mail capture) ---
NF_MAILPIT_SMTP_PORT=1025
NF_MAILPIT_UI_PORT=8025

# --- Realtime (SSE, flow-api) ---
# Toggle the in-process SSE fan-out (ADR 0005). Default true.
NF_FLOW_STREAM=true

# --- Outbound rate limiter (flow-api) ---
# Per-provider LLM egress cap in requests per second. 0 = disabled.
# When > 0, applied uniformly to anthropic / openai / google / ollama.
NF_FLOW_OUTBOUND_LLM_RPS=0
# Burst size. 0 = derived from NF_FLOW_OUTBOUND_LLM_RPS.
NF_FLOW_OUTBOUND_LLM_BURST=0

# --- AI / cost guard (flow-api) ---
# Per-workspace daily budget cap in cents. Empty = use built-in default.
NF_FLOW_AI_DAILY_BUDGET_CENTS=
# Toggle the deterministic in-memory AI provider (fixture-backed).
# true = ignore workspace.ai_providers rows, use testdata/ai/ fixtures.
NF_FLOW_AI_MOCK=false
# AI provider SSRF escape hatch. ai_providers.base_url is workspace-admin
# input, so by default a provider may only be pointed at a public unicast
# address; loopback, private, and link-local destinations (including cloud
# metadata endpoints) are refused both when the row is created and when the
# socket is dialed. Set to "1" or "true" to allow them, which is what local
# inference needs: Ollama on 127.0.0.1:11434, an OpenAI-compatible server
# on the LAN. Enabling it means any workspace admin can make this process
# issue requests inside your network and read the replies, so leave it
# empty wherever workspace admins are not fully trusted.
NF_FLOW_AI_ALLOW_PRIVATE=

# --- Redis (shared) ---
# Redis host:port shared by every redis-backed driver: the auth-api
# session store (NF_AUTH_SESSION_STORE above) and flow-api's stream
# notifier and egress limiter below. Required whenever any of them is
# set to "redis"; those services refuse to start without it.
NF_REDIS_ADDR=
NF_REDIS_PORT=6379

# --- Stream / outbound backends (flow-api) ---
# SSE fan-out driver: "memory" (default) or "redis".
NF_FLOW_STREAM_BACKEND=memory
# Egress rate limiter driver: "memory" (default) or "redis".
NF_FLOW_OUTBOUND_BACKEND=memory

# --- Agent runtime (flow-api) ---
# Global tick interval for the agent scheduler.
NF_FLOW_AGENT_TICK_INTERVAL=1m
# Queue backend: "memory" (default, single-process) or "mysql" (multi-replica).
NF_FLOW_AGENT_QUEUE_BACKEND=memory
# Number of in-process agent workers. 0 disables the worker loop.
NF_FLOW_AGENT_WORKER_COUNT=1
# Runner implementation: "orchestrator" (default, writes events + LLM calls) or "log" (structured-log only, no events).
NF_FLOW_AGENT_RUNNER=orchestrator
# How often the purger deletes completed agent_runs rows (mysql queue only).
# 0 disables the purger.
NF_FLOW_AGENT_RUNS_PURGE_INTERVAL=1h
# Minimum age before a finished agent_runs row is purged.
NF_FLOW_AGENT_RUNS_RETENTION=168h

# --- flow-worker (scheduled job runner, release-8 Phase 5) ---
# Bound to the docker `flow-worker` service (compose profile "worker").
# Internal-only Prometheus /metrics port on the worker container.
NF_FLOW_WORKER_PORT=9091
NF_FLOW_WORKER_LOG_LEVEL=info
# Base URL the worker uses to call flow-api's internal endpoints (W2+).
# Inside compose this is the service name, not the published host port.
NF_FLOW_API_BASE_URL=http://api:8080
# Tick cadence + drain budget. Defaults match the binary defaults.
NF_FLOW_WORKER_TICK_INTERVAL=60s
NF_FLOW_WORKER_SHUTDOWN_TIMEOUT=30s

# --- presence-discord (release-8 Phase 8, optional profile) ---
# Bound to the docker `presence-discord` service (compose profile
# "presence-discord"). Not started by default — bring it up explicitly
# with `docker compose --profile presence-discord up -d`.
#
# Discord bot token. Get one from the Discord Developer Portal:
#   Applications -> <your app> -> Bot -> Reset Token.
# Requires the GUILD_PRESENCES + GUILD_MEMBERS privileged intents to be
# opted in on the same Bot tab; see
# docs/conventions/discord-bot-setup.md for the full walk-through.
# Treat as a top-tier secret — leaks grant full bot privileges on every
# guild the bot is currently invited to.
NF_DISCORD_BOT_TOKEN=
# Shared secret presented to flow-api when emitting signals via
# POST /signals or calling /internal/* lookup endpoints. Generate with:
# openssl rand -hex 32. Empty disables every service-token path
# (/signals then accepts only standard user bearers; /internal/*
# rejects every request). Constant-time verified by flow-api. Consumed
# by flow-worker and presence-discord — set once, both workers pick it
# up.
NF_FLOW_API_SIGNAL_TOKEN=
# Per-user debounce window in seconds. Duplicate presence transitions
# for the same user within this window collapse to the latest event,
# suppressing Discord's online/offline storms.
NF_PRESENCE_DEBOUNCE_SECONDS=5
# Internal-only Prometheus /metrics bind address. The metrics ports are
# allocated as 9090 flow-api, 9091 flow-worker, 9092 auth-api, 9094
# presence-discord; 9093 is the only one still free for a future worker.
NF_PRESENCE_METRICS_ADDR=:9094
NF_PRESENCE_LOG_LEVEL=info

# --- S3 / MinIO (shared) ---
# S3-compatible object store for file uploads. When NF_S3_ENDPOINT is
# empty, upload endpoints return INTERNAL.NOT_CONFIGURED.
NF_S3_ENDPOINT=minio:9000
NF_S3_ACCESS_KEY=minioadmin
NF_S3_SECRET_KEY=minioadmin
NF_S3_BUCKET=nodate-flow
NF_S3_USE_SSL=false

# --- Registration (shared) ---
# Set to false to disable new user sign-up (POST /auth/register → 403).
NF_REGISTRATION_OPEN=true

# --- OAuth/OIDC sign-in allowlist (shared, opt-in) ---
# Restrict which email addresses may sign in via OAuth/OIDC (Google /
# GitHub / Microsoft). OPT-IN: leave both empty (the default) to keep
# today's open behavior where any verified email may sign in. When either
# is set the allowlist activates and a sign-in is permitted only when the
# verified email's domain is in NF_OAUTH_ALLOWED_DOMAINS OR the full
# address is in NF_OAUTH_ALLOWED_EMAILS (otherwise AUTH.OIDC.DOMAIN_NOT_ALLOWED,
# 403). Comma-separated; entries are lower-cased and trimmed, and a
# leading "@" on a domain is optional.
# Example: NF_OAUTH_ALLOWED_DOMAINS=example.com,corp.example.org
NF_OAUTH_ALLOWED_DOMAINS=
# Example: NF_OAUTH_ALLOWED_EMAILS=ceo@example.com,ops@vendor.example
NF_OAUTH_ALLOWED_EMAILS=

# --- S3 / MinIO ports (compose only) ---
NF_S3_PORT=9000
NF_S3_CONSOLE_PORT=9001

# --- Observability (compose only) ---
NF_OTEL_GRPC_PORT=4317
NF_OTEL_HTTP_PORT=4318
NF_PROMETHEUS_PORT=9090
NF_GRAFANA_PORT=3001
NF_GRAFANA_USER=admin
NF_GRAFANA_PASSWORD=admin

# --- OTLP (flow-api) ---
NF_FLOW_OTEL_ENDPOINT=otel-collector:4317
NF_FLOW_OTEL_INSECURE=true

# --- Rate limiting ---
# Disable all per-IP rate limiters. Set to true for local E2E test runs
# where back-to-back test suites exhaust the default quotas.
NF_AUTH_DISABLE_RATE_LIMIT=false
NF_FLOW_DISABLE_RATE_LIMIT=false

# --- Tests ---
# Integration tests are on by default; the Makefile supplies the value and
# deliberately ignores any setting made here, because `make` lets an included
# file win over both `?=` and the environment. Turning them off is a
# command-line assignment: `make test NF_TEST_INTEGRATION=`.
