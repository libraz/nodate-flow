# nodate-flow environment variables (copy to .env and fill in).
# All runtime config uses the NF_* prefix. Never commit .env.

# --- API server ---
NF_PORT=8080
NF_LOG_LEVEL=info
# Optional build/version tag surfaced in logs and /health.
NF_VERSION=dev

# Comma-separated list of origins allowed to call the API with
# credentials. Defaults to the Vite dev server on localhost. Set to
# "*" to allow any origin (credentials will then be disabled per the
# CORS spec). Leave empty to disable CORS entirely.
NF_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# DSN used by the api process to reach MySQL.
# In compose, the mysql service is reachable as host "mysql".
NF_DB_DSN=nodate:nodatepw@tcp(mysql:3306)/nodate_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
# Used only by the mysql container during first boot.
NF_DB_NAME=nodate_flow
NF_DB_USER=nodate
NF_DB_PASSWORD=nodatepw
NF_DB_ROOT_PASSWORD=rootpw
NF_DB_PORT=3306
NF_API_PORT=8080

# --- Secrets / crypto ---
# 32-byte master key for AES-256-GCM column encryption, hex or base64.
# Generate with: openssl rand -hex 32
NF_SECRET_KEY=

# --- Auth (optional at scaffold time) ---
# Ed25519 private key for JWT signing (PEM). Ephemeral if unset.
NF_JWT_PRIVATE_KEY=
NF_OIDC_GOOGLE_CLIENT_ID=
NF_OIDC_GOOGLE_CLIENT_SECRET=
NF_OIDC_GOOGLE_REDIRECT_URL=
# Toggles the Secure flag on the httpOnly refresh cookie (nf_rt).
# - false (default here): http://localhost dev. The cookie is sent as
#   SameSite=Lax so the browser stores it and replays it on the boot
#   POST /auth/refresh call from the Vite dev server.
# - true: any https deployment. The cookie is sent as SameSite=None;
#   Secure so it survives the cross-site fetch from the web origin to
#   the api origin.
# Override this to true in any non-localhost environment.
NF_COOKIE_SECURE=false

# --- Integrations ---
# Shared HMAC secret for GitHub webhook (X-Hub-Signature-256).
NF_GH_WEBHOOK_SECRET=
# Slack v0 signing secret.
NF_SLACK_SIGNING_SECRET=
# Stop-gap: public workspace id (UUID v7) that inbound webhook
# signals are routed to until a per-repo mapping table exists.
NF_DEFAULT_WORKSPACE_ID=

# --- Realtime (SSE) ---
# Toggle the in-process SSE fan-out (ADR 0005). Default true.
NF_STREAM=true

# --- AI / cost guard ---
# Per-workspace daily budget cap in cents. Empty = use built-in default.
NF_AI_DAILY_BUDGET_CENTS=

# --- Tests ---
# Set to 1 to enable integration tests that require a live MySQL.
NF_TEST_INTEGRATION=
