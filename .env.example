# nodate-flow environment variables (copy to .env and fill in).
# All runtime config uses the NF_* prefix. Never commit .env.
#
# Per-app sub-prefixes:
#   NF_FLOW_*  — flow-api specific (calendar handlers live here too)
#   NF_AUTH_*  — auth-api specific
# Shared vars have no sub-prefix (NF_DB_DSN, NF_COOKIE_SECURE, etc.).

# --- flow-api server ---
NF_FLOW_PORT=8080
NF_FLOW_LOG_LEVEL=info
# Optional build/version tag surfaced in logs and /health.
NF_VERSION=dev

# Comma-separated list of origins allowed to call the API with
# credentials. Defaults to the Vite dev server on localhost. Set to
# "*" to allow any origin (credentials will then be disabled per the
# CORS spec). Leave empty to disable CORS entirely.
NF_FLOW_CORS=http://localhost:5173,http://127.0.0.1:5173

# --- auth-api server ---
NF_AUTH_PORT=8082
NF_AUTH_LOG_LEVEL=info
NF_AUTH_CORS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175
# Dev-only: when true, both APIs additionally accept any
# http://localhost:<port> or http://127.0.0.1:<port> origin (on top of
# NF_FLOW_CORS / NF_AUTH_CORS). Use this when the Vite dev server lands
# on a non-default port (e.g. 5183 because 5173 is already taken). Leave
# false (the default) in any non-localhost deployment.
NF_CORS_DEV_LOCALHOST=false
NF_AUTH_SESSION_STORE=mysql
NF_AUTH_PUBLIC_URL=http://localhost:8082
NF_AUTH_WEB_URL=http://localhost:5175
NF_AUTH_FLOW_WEB_URL=http://localhost:5173

# --- auth-api integrations (OAuth personal connections) ---
NF_AUTH_GITHUB_CLIENT_ID=
NF_AUTH_GITHUB_CLIENT_SECRET=
NF_AUTH_SLACK_CLIENT_ID=
NF_AUTH_SLACK_CLIENT_SECRET=
NF_AUTH_GOOGLE_INTEGRATION_CLIENT_ID=
NF_AUTH_GOOGLE_INTEGRATION_CLIENT_SECRET=

# --- auth-api SMTP ---
NF_AUTH_SMTP_HOST=mailpit
NF_AUTH_SMTP_PORT=1025
NF_AUTH_SMTP_USERNAME=
NF_AUTH_SMTP_PASSWORD=
NF_AUTH_SMTP_FROM=noreply@nodate-flow.local

# --- Database (shared) ---
# DSN used by all api processes to reach MySQL.
# In compose, the mysql service is reachable as host "mysql".
NF_DB_DSN=nodate:nodatepw@tcp(mysql:3306)/nodate_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
# Used only by the mysql container during first boot.
NF_DB_NAME=nodate_flow
NF_DB_USER=nodate
NF_DB_PASSWORD=nodatepw
NF_DB_ROOT_PASSWORD=rootpw
NF_DB_PORT=3306
NF_API_PORT=8080

# --- Secrets / crypto ---
# 32-byte master key for AES-256-GCM column encryption, hex or base64.
# Generate with: openssl rand -hex 32
NF_SECRET_KEY=

# --- Auth (shared) ---
# Ed25519 private key for JWT signing (PEM). Ephemeral if unset.
NF_JWT_PRIVATE_KEY=
NF_AUTH_GOOGLE_CLIENT_ID=
NF_AUTH_GOOGLE_CLIENT_SECRET=
# Toggles the Secure flag on the httpOnly refresh cookie (nf_rt).
# - false (default here): http://localhost dev. The cookie is sent as
#   SameSite=Lax so the browser stores it and replays it on the boot
#   POST /auth/refresh call from the Vite dev server.
# - true: any https deployment. The cookie is sent as SameSite=None;
#   Secure so it survives the cross-site fetch from the web origin to
#   the api origin.
# Override this to true in any non-localhost environment.
NF_COOKIE_SECURE=false

# --- URLs (flow-api) ---
# Externally-visible origin of the flow-api, used to build OAuth redirect
# URIs for personal integrations (GitHub, Slack, Google Calendar).
NF_FLOW_PUBLIC_URL=http://localhost:8080
# Origin of the flow-web frontend. Used by flow-api for OAuth callback
# redirects and by the calendar handlers to build /invites/accept
# magic-link URLs embedded in outbound calendar invite emails.
NF_FLOW_WEB_URL=http://localhost:5173

# --- Integrations: webhooks (flow-api) ---
# Shared HMAC secret for GitHub webhook (X-Hub-Signature-256).
NF_FLOW_GH_WEBHOOK_SECRET=
# Slack v0 signing secret.
NF_FLOW_SLACK_SIGNING_SECRET=
# Google Drive push notification channel token.
NF_FLOW_GOOGLE_CHANNEL_TOKEN=
# Stop-gap: public workspace id (UUID v7) that inbound webhook
# signals are routed to until a per-repo mapping table exists.
NF_FLOW_DEFAULT_WORKSPACE_ID=

# --- Integrations: OAuth apps (personal integrations, flow-api) ---
# All optional. When client id/secret is empty the provider reports
# as unavailable and enrollment returns INTEGRATION.PROVIDER.NOT_CONFIGURED.
NF_FLOW_GITHUB_CLIENT_ID=
NF_FLOW_GITHUB_CLIENT_SECRET=
NF_FLOW_SLACK_CLIENT_ID=
NF_FLOW_SLACK_CLIENT_SECRET=
NF_FLOW_GOOGLE_CLIENT_ID=
NF_FLOW_GOOGLE_CLIENT_SECRET=

# --- flow-api SMTP ---
NF_FLOW_SMTP_HOST=mailpit
NF_FLOW_SMTP_PORT=1025
NF_FLOW_SMTP_USERNAME=
NF_FLOW_SMTP_PASSWORD=
NF_FLOW_SMTP_FROM=noreply@nodate-flow.local

# --- Mailpit (dev mail capture) ---
NF_MAILPIT_SMTP_PORT=1025
NF_MAILPIT_UI_PORT=8025

# --- Realtime (SSE, flow-api) ---
# Toggle the in-process SSE fan-out (ADR 0005). Default true.
NF_FLOW_STREAM=true

# --- Outbound rate limiter (flow-api) ---
# Per-provider LLM egress cap in requests per second. 0 = disabled.
# When > 0, applied uniformly to anthropic / openai / google / ollama.
NF_FLOW_OUTBOUND_LLM_RPS=0
# Burst size. 0 = derived from NF_FLOW_OUTBOUND_LLM_RPS.
NF_FLOW_OUTBOUND_LLM_BURST=0

# --- AI / cost guard (flow-api) ---
# Per-workspace daily budget cap in cents. Empty = use built-in default.
NF_FLOW_AI_DAILY_BUDGET_CENTS=
# Toggle the deterministic in-memory AI provider (fixture-backed).
# true = ignore workspace.ai_providers rows, use testdata/ai/ fixtures.
NF_FLOW_AI_MOCK=false

# --- Session / Redis (shared) ---
# Session store driver: "mysql" (default) or "redis".
NF_FLOW_SESSION_STORE=mysql
# Redis host:port shared by redis-tagged drivers (session, stream, outbound).
NF_REDIS_ADDR=
NF_REDIS_PORT=6379

# --- Stream / outbound backends (flow-api) ---
# SSE fan-out driver: "memory" (default) or "redis".
NF_FLOW_STREAM_BACKEND=memory
# Egress rate limiter driver: "memory" (default) or "redis".
NF_FLOW_OUTBOUND_BACKEND=memory

# --- Agent runtime (flow-api) ---
# Global tick interval for the agent scheduler.
NF_FLOW_AGENT_TICK_INTERVAL=1m
# Queue backend: "memory" (default, single-process) or "mysql" (multi-replica).
NF_FLOW_AGENT_QUEUE_BACKEND=memory
# Number of in-process agent workers. 0 disables the worker loop.
NF_FLOW_AGENT_WORKER_COUNT=1
# Runner implementation: "orchestrator" (default, writes events + LLM calls) or "log" (structured-log only, no events).
NF_FLOW_AGENT_RUNNER=orchestrator
# How often the purger deletes completed agent_runs rows (mysql queue only).
# 0 disables the purger.
NF_FLOW_AGENT_RUNS_PURGE_INTERVAL=1h
# Minimum age before a finished agent_runs row is purged.
NF_FLOW_AGENT_RUNS_RETENTION=168h

# --- S3 / MinIO (shared) ---
# S3-compatible object store for file uploads. When NF_S3_ENDPOINT is
# empty, upload endpoints return INTERNAL.NOT_CONFIGURED.
NF_S3_ENDPOINT=minio:9000
NF_S3_ACCESS_KEY=minioadmin
NF_S3_SECRET_KEY=minioadmin
NF_S3_BUCKET=nodate-flow
NF_S3_USE_SSL=false

# --- Registration (shared) ---
# Set to false to disable new user sign-up (POST /auth/register → 403).
NF_REGISTRATION_OPEN=true

# --- S3 / MinIO ports (compose only) ---
NF_S3_PORT=9000
NF_S3_CONSOLE_PORT=9001

# --- Observability (compose only) ---
NF_OTEL_GRPC_PORT=4317
NF_OTEL_HTTP_PORT=4318
NF_PROMETHEUS_PORT=9090
NF_GRAFANA_PORT=3001
NF_GRAFANA_USER=admin
NF_GRAFANA_PASSWORD=admin

# --- OTLP (flow-api) ---
NF_FLOW_OTEL_ENDPOINT=otel-collector:4317
NF_FLOW_OTEL_INSECURE=true

# --- Rate limiting ---
# Disable all per-IP rate limiters. Set to true for local E2E test runs
# where back-to-back test suites exhaust the default quotas.
NF_AUTH_DISABLE_RATE_LIMIT=false
NF_FLOW_DISABLE_RATE_LIMIT=false

# --- Tests ---
# Set to 1 to enable integration tests that require a live MySQL.
NF_TEST_INTEGRATION=
