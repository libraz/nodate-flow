[
  {
    "name": "monthly Jan 31 clamps each occurrence independently from the anchor",
    "event": {
      "startAt": "2026-01-31T09:00:00-05:00",
      "endAt": "2026-01-31T10:00:00-05:00",
      "timezone": "America/New_York",
      "recurrenceRule": { "freq": "monthly", "count": 4 }
    },
    "rangeStart": "2026-01-01T00:00:00Z",
    "rangeEnd": "2026-05-01T00:00:00Z",
    "expectedStartAt": [
      "2026-01-31T14:00:00Z",
      "2026-02-28T14:00:00Z",
      "2026-03-31T13:00:00Z",
      "2026-04-30T13:00:00Z"
    ]
  },
  {
    "name": "monthly Jan 31 keeps the clamped last-valid day for 12 months without drifting to the 28th",
    "event": {
      "startAt": "2026-01-31T09:00:00Z",
      "endAt": "2026-01-31T10:00:00Z",
      "recurrenceRule": { "freq": "monthly", "count": 12 }
    },
    "rangeStart": "2026-01-01T00:00:00Z",
    "rangeEnd": "2027-01-01T00:00:00Z",
    "expectedStartAt": [
      "2026-01-31T09:00:00Z",
      "2026-02-28T09:00:00Z",
      "2026-03-31T09:00:00Z",
      "2026-04-30T09:00:00Z",
      "2026-05-31T09:00:00Z",
      "2026-06-30T09:00:00Z",
      "2026-07-31T09:00:00Z",
      "2026-08-31T09:00:00Z",
      "2026-09-30T09:00:00Z",
      "2026-10-31T09:00:00Z",
      "2026-11-30T09:00:00Z",
      "2026-12-31T09:00:00Z"
    ]
  },
  {
    "name": "weekly BYDAY MO-FR expands each weekday across three weeks",
