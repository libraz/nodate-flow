{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/apps/flow-api/internal/db/generated",
      "!**/apps/flow-api/internal/errors",
      "!**/packages/sdk/src/errors",
      "!**/packages/sdk/src/signal-kinds",
      "!**/apps/flow-web/locales/en/signal-kinds.json",
      "!**/apps/flow-web/locales/ja/signal-kinds.json",
      "!**/apps/flow-web/locales/zh/signal-kinds.json",
      "!**/apps/flow-web/src/routeTree.gen.ts",
      "!**/apps/accounts-web/src/routeTree.gen.ts",
      "!**/packages/sdk/src/openapi.ts",
      "!**/packages/sdk/src/schema.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "function"
                },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeLike"
                },
                "formats": ["PascalCase"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["log"] } }
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useHookAtTopLevel": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**", "**/e2e/**", "**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx", "**/*.test.ts"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/packages/ui/src/primitives/**", "**/apps/flow-web/src/features/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useFocusableInteractive": "off",
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/apps/*/src/features/**",
        "**/apps/*/src/routes/**",
        "**/apps/*/src/components/**",
        "**/apps/*/src/providers/**",
        "**/apps/*/src/hooks/**",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "openapi-fetch": {
                    "message": "Build clients in lib/sdk only. Feature and route code reaches the API through lib/api, whose requester converts every failure into an ApiError carrying the HTTP status, error code, translation key and recovery hint."
                  }
                },
                "patterns": [
                  {
                    "group": ["**/lib/sdk"],
                    "importNamePattern": "sdk|authSdk",
                    "message": "Import apiRequest / authApiRequest / apiProbe / apiSettle from lib/api instead of the raw client. A call made straight on the client returns a result whose failure is easy to read as a success — a bodyless 405 or 502 arrives with no error at all — and every hand-written conversion so far has dropped the HTTP status, the error code, the translation key and the recovery hint."
                  },
                  {
                    "group": ["@nodate-flow/sdk"],
                    "importNamePattern": "createClient|createRefreshMiddleware|createAuthRequestMiddleware|createTokenRefresher|createApiRequester",
                    "message": "Client construction belongs in lib/sdk and lib/api. Feature and route code reaches the API through the requesters lib/api exports; types from @nodate-flow/sdk stay fine to import here."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
