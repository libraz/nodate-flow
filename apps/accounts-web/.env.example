# accounts-web environment variables (copy to .env.local for local overrides).
# All Vite-exposed variables MUST use the VITE_ prefix.

# --- API endpoints ---
# Origin of the auth-api identity backend.
VITE_AUTH_API_BASE_URL=http://localhost:8082

# --- Product frontend ---
# Origin of the flow-web product frontend. Used to link to /setup and, in
# combination with the allowlist below, to permit the post-sign-in
# hand-off back to the product. Unset means "same origin".
VITE_FLOW_WEB_URL=

# --- Redirect allowlist ---
# Comma-separated list of extra origins that `?redirect=` may point at
# after sign-in. This origin is always allowed; anything not listed here
# is refused and the user lands on /profile. Add every product origin the
# deployment serves (e.g. per-workspace subdomains).
# Example: VITE_NF_ALLOWED_REDIRECT_ORIGINS=https://acme.nodate-flow.dev,https://beta.nodate-flow.dev
VITE_NF_ALLOWED_REDIRECT_ORIGINS=
