# flow-web environment variables (copy to .env.local for local overrides).
# All Vite-exposed variables MUST use the VITE_ prefix.

# --- API endpoints ---
# Origin of the flow-api product backend.
VITE_API_BASE_URL=http://localhost:8080
# Origin of the auth-api identity backend.
VITE_AUTH_API_BASE_URL=http://localhost:8082
# Origin of the accounts-web identity frontend (login / signup redirects).
VITE_ACCOUNTS_WEB_URL=http://localhost:5175

# --- Public-facing origin ---
# Canonical user-facing origin used to build outbound share and invite
# URLs (e.g. /share/cal/{token}, /invites/accept). When unset, the app
# falls back to window.location.origin and emits a dev-mode warning.
# Override this in deployments where the runtime origin differs from the
# canonical user-facing origin (reverse proxies, custom domains).
VITE_PUBLIC_BASE_URL=
