# flow-web environment variables (copy to .env.local for local overrides).
# All Vite-exposed variables MUST use the VITE_ prefix.

# --- API endpoints ---
# Origin of the flow-api product backend.
VITE_API_BASE_URL=http://localhost:8080
# Origin of the auth-api identity backend.
VITE_AUTH_API_BASE_URL=http://localhost:8082
# URL (origin + /accounts) of the accounts-web identity frontend (login / signup redirects).
VITE_ACCOUNTS_WEB_URL=http://localhost:5175/accounts

# --- Public-facing origin ---
# Canonical user-facing origin used to build outbound share and invite
# URLs (e.g. /share/cal/{token}, /invites/accept). When unset, the app
# falls back to window.location.origin and emits a dev-mode warning.
# Override this in deployments where the runtime origin differs from the
# canonical user-facing origin (reverse proxies, custom domains).
VITE_PUBLIC_BASE_URL=

# --- Branding ---
# Product name: 64 chars max, no ':' or control characters. Empty = default.
# VITE_APP_NAME=
# Logo containing the product name; replaces the name text. https URL or
# data:image URI, 32 KiB max. Empty = none.
# VITE_APP_LOGO_URL=
# Square symbol; replaces the built-in mark and is the favicon. Same format.
# VITE_APP_ICON_URL=
# Dark-theme variants (web only; each requires its base variable).
# VITE_APP_LOGO_DARK_URL=
# VITE_APP_ICON_DARK_URL=
