{
  "due before next monday": {
    "op": "time.due_before",
    "arg": "2026-04-13"
  },
  "all dependencies done and a reviewer assigned": {
    "op": "and",
    "terms": [
      { "op": "dependency.all_done", "taskIds": ["*"] },
      { "op": "actor.has_role", "arg": "reviewer" }
    ]
  },
  "pr merged": {
    "op": "signal.received",
    "arg": "pull_request.merged"
  },
  "at most one open dependency": {
    "op": "dependency.open_at_most",
    "max": 1
  }
}
