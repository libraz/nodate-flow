{
  "due before next monday": {
    "op": "time.due_before",
    "arg": "2026-04-13"
  },
  "all dependencies done and reviewer approved": {
    "op": "and",
    "terms": [
      { "op": "dependency.all_done", "taskIds": ["*"] },
      { "op": "approval.granted", "arg": "reviewer" }
    ]
  },
  "ci green and pr merged": {
    "op": "and",
    "terms": [
      { "op": "ci.status_is", "arg": "success" },
      { "op": "signal.received", "arg": "github.pr.merged" }
    ]
  },
  "at most one open dependency": {
    "op": "dependency.open_at_most",
    "max": 1
  }
}
